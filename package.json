{
  "name": "agy-nov",
  "version": "1.2.2",
  "description": "The 100% Native Modular Super-Workbench for Google Antigravity 2.0 — 13 toggleable superpowers (Diff Review, Guard & Snapshots, Context X-Ray, Turbo RTK Compression, Session Radar, Verify Gate, Worktree Orchestrator, Spec Flow & Task DAG, Workspace Studio, Visual Canvas, Memory Graph, Prompt Vault & Budget Doctor, and Opt-In Mobile/IM Remote), native 8-language UI, CLI statusLine, Zero ASAR, Zero CDP, zero token tax when off.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "agy-nov": "./bin/agy-nov-cli"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "node scripts/bundle-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "workbench": "npm run build && node workbench/server.mjs",
    "cli": "node dist/cli.cjs"
  },
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "google-antigravity",
    "mcp",
    "mcp-server",
    "mcp-app",
    "ext-apps",
    "sep-1865",
    "zero-cdp",
    "offline-first",
    "modular-workbench",
    "code-review",
    "guardrails",
    "pre-edit-snapshots",
    "secret-scanner",
    "context-xray",
    "token-analytics",
    "context-compression",
    "session-radar",
    "prompt-vault",
    "agent-memory",
    "visual-canvas",
    "remote-control",
    "i18n",
    "multilingual",
    "ai-agents",
    "developer-tools"
  ],
  "author": "tone-leh",
  "repository": {
    "type": "git",
    "url": "https://github.com/tone-leh/agy-NOV.git"
  },
  "homepage": "https://github.com/tone-leh/agy-NOV#readme",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
