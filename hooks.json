{
  "agy-nov-hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node dist/hook.cjs --event SessionStart",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|edit_file|write_file|write_to_file|create_file|patch_file|apply_patch|replace_file_content|multi_replace_file_content|delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/hook.cjs --event PreToolUse",
            "timeout": 28
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/hook.cjs --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node dist/hook.cjs --event PreInvocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node dist/hook.cjs --event PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node dist/hook.cjs --event Stop",
        "timeout": 20
      }
    ]
  }
}
